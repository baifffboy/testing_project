        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"  \",\n  \"gender\": \"M\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
