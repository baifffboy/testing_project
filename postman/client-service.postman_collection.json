{
  "info": {
    "name": "client-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "В ответе API нет поля id, поэтому переменная clientId задана вручную (по умолчанию 1). Узнать id созданного клиента: SELECT id FROM client_account ORDER BY id DESC LIMIT 1; и поставить его в переменную коллекции clientId."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Создать клиента (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/clients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "clients"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Иванов Иван Иванович\",\n  \"gender\": \"M\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Статус клиента ACTIVE', () => pm.expect(json.status).to.eql('ACTIVE'));",
              "pm.test('В ответе нет id', () => pm.expect(json).to.not.have.property('id'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Создать клиента - пустое ФИО (400)",
      "request": {
        "method": "POST",
        "header": [
          {
