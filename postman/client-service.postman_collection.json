            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('ФИО обновлено', () => pm.expect(json.fullName).to.eql('Иванов Пётр Иванович'));",
              "pm.test('Статус INACTIVE', () => pm.expect(json.status).to.eql('INACTIVE'));"
            ]
          }
        }
      ]
    },
