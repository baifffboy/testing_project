              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Есть fullName', () => pm.expect(json.fullName).to.be.a('string'));",
              "pm.test('В ответе нет id', () => pm.expect(json).to.not.have.property('id'));"
            ]
          }
        }
      ]
    },
