            "{{clientId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Иванов Пётр Иванович\",\n  \"status\": \"INACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
